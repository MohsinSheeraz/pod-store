# Copy to .env and fill in. In production set these in your host's environment settings instead.
# Full explanations: docs/DEPLOYMENT.md

# ---- Required ---------------------------------------------------------------------------------
# PostgreSQL connection string. Use a SEPARATE database for production.
DATABASE_URL=

# Random secret that signs login sessions. 32+ characters.   openssl rand -base64 48
AUTH_SECRET=

# The public address of the site, no trailing slash. https:// in production.
SITE_URL=http://localhost:3000
# NextAuth must trust the host it runs on (needed behind most hosts and proxies)
AUTH_TRUST_HOST=true

# ---- Payments (Stripe) ------------------------------------------------------------------------
# Without STRIPE_SECRET_KEY: development simulates payment (orders are paid instantly, nobody is
# charged) and PRODUCTION CHECKOUT IS DISABLED. It never gives orders away.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint  https://<your site>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd

# ---- Prices -----------------------------------------------------------------------------------
SHIPPING_FLAT=4.99
FREE_SHIPPING_OVER=75
# 0.0825 means 8.25%. Leave 0 if you don't charge tax.
TAX_RATE=0

# ---- Uploads (any S3-compatible storage: AWS S3, Cloudflare R2, DigitalOcean Spaces...) -------
# Without a bucket: development saves to public/uploads, PRODUCTION UPLOADS ARE DISABLED.
S3_BUCKET=
S3_REGION=us-east-1
# Leave empty for AWS S3. R2: https://<account>.r2.cloudflarestorage.com  Spaces: https://nyc3.digitaloceanspaces.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Address browsers load files from (a CDN, or the bucket's public URL). No trailing slash.
S3_PUBLIC_URL=

# ---- Email (Resend) ---------------------------------------------------------------------------
# Without a key: development prints emails to the server console; production sends none and
# skips email verification.
RESEND_API_KEY=
EMAIL_FROM="Pressroom <orders@yourdomain.com>"
SUPPORT_EMAIL=support@yourdomain.com
COMPANY_NAME=Pressroom

# ---- Abuse protection (optional but recommended on serverless hosts) --------------------------
# Upstash Redis REST: shares rate limits across all server instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Monitoring (optional) --------------------------------------------------------------------
# Server errors are posted here (Slack or Discord incoming webhook).
ERROR_WEBHOOK_URL=

# ---- Embedding (optional) ---------------------------------------------------------------------
# Sites allowed to show this site in a frame, space separated. Default: only itself.
# FRAME_ANCESTORS="https://digitemb.com https://www.digitemb.com"

# ---- First admin (used by `npm run db:seed`) --------------------------------------------------
# No admin is created unless both are set. 12+ character password. Or run:
#   npm run admin:create -- you@example.com "a long passphrase"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
